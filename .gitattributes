# Windows batch files MUST be CRLF or cmd.exe breaks (window closes instantly).
# Store verbatim (-text) so a plain pull/clone — and GitHub "Download ZIP" —
# always delivers CRLF regardless of the user's core.autocrlf setting.
*.bat   -text
*.cmd   -text

# Unix shell / macOS launchers MUST stay LF.
*.sh        text eol=lf
*.command   text eol=lf
